# Copy to .env.local for local dev. In Vercel, set these per environment.
# Only publishable values belong here: the waitlist uses the Supabase
# publishable key; the waitlist table is closed and only join_waitlist() writes to it.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_LEGAL_ENTITY=[LEGAL ENTITY]

# Server-only (no NEXT_PUBLIC_ prefix), read by the waitlist server action.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
